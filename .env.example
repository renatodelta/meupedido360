# ==============================================================================
# MEUPEDIDO360 - VARIÁVEIS DE AMBIENTE DE EXEMPLO (.env.example)
# Copie este arquivo para ".env.local" e preencha com suas credenciais.
# ==============================================================================

# 1. SUPABASE (BANCO DE DADOS & AUTENTICAÇÃO)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=seu-anon-key-publico
SUPABASE_SERVICE_ROLE_KEY=seu-service-role-key-privado

# 2. ASAAS (GATEWAY DE PAGAMENTOS E ASSINATURAS)
ASAAS_API_KEY=$aact_sua_chave_de_api_aqui
ASAAS_WEBHOOK_SECRET=seu_token_de_acesso_webhook
NEXT_PUBLIC_ASAAS_CHECKOUT_URL=https://www.asaas.com/c/seu_link_aqui
ASAAS_ENVIRONMENT=production # 'production' ou 'sandbox'

# 3. URLS DA PLATAFORMA
NEXT_PUBLIC_APP_URL=http://localhost:3000
